# Clé Google Places API (New) — colle ta clé après le "=" (sans guillemets).
# Tant que c'est vide, le site garde les avis statiques de secours.
VITE_GOOGLE_PLACES_KEY=

# Où partent les demandes du formulaire de contact. Destination visée :
# contact@spro.fr.
#
# Le plus simple : Web3Forms (web3forms.com). On y saisit contact@spro.fr, la
# clé arrive par mail, il n'y a pas de compte à créer ni de mot de passe.
#   VITE_CONTACT_ENDPOINT=https://api.web3forms.com/submit
#   VITE_CONTACT_KEY=la-clé-reçue-par-mail
#
# Formspree fonctionne aussi (compte requis) : l'URL suffit, laisser la clé vide.
#   VITE_CONTACT_ENDPOINT=https://formspree.io/f/xxxxxxxx
#
# Tant que l'endpoint est vide, le formulaire refuse d'afficher « Merci » et
# renvoie vers le téléphone et l'e-mail — il ne fait jamais semblant d'envoyer.
VITE_CONTACT_ENDPOINT=
VITE_CONTACT_KEY=

# Où sont hébergées les vidéos du hero.
# Vide = servies depuis le site lui-même (dist/media/, ~240 Mo).
# À remplir si les vidéos partent sur un CDN ou un stockage objet — par ex.
# https://spro.b-cdn.net — ce qui évite d'embarquer 240 Mo dans chaque déploiement
# et contourne les limites de taille de fichier de certains hébergeurs.
# Pas de barre oblique finale.
VITE_MEDIA_BASE=
