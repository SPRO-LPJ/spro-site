# Dépendances et build — régénérés par `npm install` puis `npm run build`.
node_modules/
dist/

# Secrets. `.env` contient les clés Places et du formulaire : elles se
# renseignent dans l'interface Vercel, jamais dans le dépôt.
.env
.env.*
!.env.example
# Sauf les valeurs par défaut de production : sans elles, le build échoue sur
# le marqueur %VITE_MEDIA_BASE% resté dans index.html. Aucun secret dedans.
!.env.production

# Sources de travail : rushes vidéo, originaux photo, sauvegardes.
# ~3 Go, sans aucune utilité pour le site déployé — seuls les fichiers
# optimisés de public/ sont servis.
masters/
_media-backup/

# Sorties d'outils
.playwright-mcp/
*.log

# macOS
.DS_Store
